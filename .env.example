# ============================================================================
# Student Record Management System - Environment Configuration Example
# Copy this file to .env for local overrides if needed (never commit .env)
# ============================================================================

# Flask secret key used for session cookies and flash messages.
# Replace with a random string in production.
FLASK_SECRET_KEY=dev-local-secret-key-change-in-production

# Storage mode: "sqlite" (default for local Windows run) or "dynamodb" (for AWS EC2)
STORAGE_BACKEND=sqlite

# Local SQLite database file path (used only when STORAGE_BACKEND=sqlite)
SQLITE_DB_PATH=.data/students.db

# AWS DynamoDB settings (used only when STORAGE_BACKEND=dynamodb)
# IMPORTANT: Never store AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in code or git.
# On Amazon EC2, attach an IAM Role / Instance Profile instead.
DYNAMODB_TABLE_NAME=StudentRecords
AWS_DEFAULT_REGION=ap-south-1

# Application host and port for local development
HOST=127.0.0.1
PORT=5000
